{
  "elements": [
    {
      "type": "Label",
      "caption": "Zentrale Steuerung fuer zwei 3-stufige Heizgeblaese und eine gemeinsame Pumpe. Es werden Variablen-IDs (nicht Instanz-IDs) benoetigt."
    },
    {
      "type": "Label",
      "caption": "Zeitsteuerung: nativer Wochenplan im WebFront mit AUS sowie Stufe 1, 2, 3. Je Stufe eine Ventiloeffnung. Im Zeitmodus kann die Stufe manuell bis zum naechsten Schaltpunkt uebersteuert werden. Die Zeitsteuerung wird in anderen Modi ausgeblendet."
    },
    {
      "type": "ExpansionPanel",
      "caption": "Gemeinsame Pumpe",
      "items": [
        {
          "type": "SelectVariable",
          "name": "PumpSwitch",
          "caption": "Pumpe: schaltbare Statusvariable (Boolean)"
        }
      ]
    },
    {
      "type": "ExpansionPanel",
      "caption": "Werkstatt",
      "items": [
        {
          "type": "SelectVariable",
          "name": "WorkshopOut1",
          "caption": "Shelly Ausgang 1: Status"
        },
        {
          "type": "SelectVariable",
          "name": "WorkshopOut2",
          "caption": "Shelly Ausgang 2: Status 1"
        },
        {
          "type": "SelectVariable",
          "name": "WorkshopValve",
          "caption": "Ventil: Position (0–100 %)"
        },
        {
          "type": "SelectVariable",
          "name": "WorkshopTemp",
          "caption": "Ventil: Vorlauftemperatur"
        },
        {
          "type": "NumberSpinner",
          "name": "WorkshopValveDefault",
          "caption": "Anfangswert Ventil-Sollwert bei erster Anlage (%)",
          "minimum": 0,
          "maximum": 100
        },
        {
          "type": "SelectVariable",
          "name": "WorkshopRoomTemp",
          "caption": "Raumtemperatur (optional)"
        }
      ]
    },
    {
      "type": "ExpansionPanel",
      "caption": "Garage",
      "items": [
        {
          "type": "SelectVariable",
          "name": "GarageOut1",
          "caption": "Shelly Ausgang 1: Status"
        },
        {
          "type": "SelectVariable",
          "name": "GarageOut2",
          "caption": "Shelly Ausgang 2: Status 1"
        },
        {
          "type": "SelectVariable",
          "name": "GarageValve",
          "caption": "Ventil: Position (0–100 %)"
        },
        {
          "type": "SelectVariable",
          "name": "GarageTemp",
          "caption": "Ventil: Vorlauftemperatur"
        },
        {
          "type": "NumberSpinner",
          "name": "GarageValveDefault",
          "caption": "Anfangswert Ventil-Sollwert bei erster Anlage (%)",
          "minimum": 0,
          "maximum": 100
        },
        {
          "type": "SelectVariable",
          "name": "GarageRoomTemp",
          "caption": "Raumtemperatur (optional)"
        }
      ]
    },
    {
      "type": "ExpansionPanel",
      "caption": "Betrieb",
      "items": [
        {
          "type": "Label",
          "caption": "Betriebsmodus wird je Heizgebläse über die Instanzvariable im Objektbaum eingestellt. Auto ist vorbereitet, schaltet aber noch nicht ein."
        },
        {
          "type": "NumberSpinner",
          "name": "RefreshSeconds",
          "caption": "Status-/Temperaturabfrage (Sekunden)",
          "minimum": 2,
          "maximum": 3600
        },
        {
          "type": "CheckBox",
          "name": "PumpWatchdog",
          "caption": "Pumpe bei erkanntem laufendem Geblaese automatisch sicherstellen"
        }
      ]
    }
  ],
  "actions": [
    {
      "type": "Label",
      "caption": "Zeitsteuerung: IP-Symcon-Wochenplan (Wochenuebersicht) pro Raum mit AUS und vier Profilen. Vorlauftemperatur wird als Float angezeigt."
    }
  ]
}
