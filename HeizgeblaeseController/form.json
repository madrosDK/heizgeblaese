{
  "elements": [
    {
      "type": "Label",
      "caption": "Zentrale Steuerung fuer zwei 3-stufige Heizgeblaese und eine gemeinsame Pumpe. Es werden Variablen-IDs (nicht Instanz-IDs) benoetigt."
    },
    {
      "type": "Label",
      "caption": "Zeitfenster jetzt direkt im WebFront unter Werkstatt / Garage → Zeitsteuerung einstellen. Bestehende V1.2 Zeitfenster werden einmalig importiert. Jeder Bereich bekommt eigene Dummy-Module."
    },
    {
      "type": "ExpansionPanel",
      "caption": "Gemeinsame Pumpe",
      "items": [
        {
          "type": "SelectVariable",
          "name": "PumpSwitch",
          "caption": "Pumpe: schaltbare Statusvariable (Boolean)"
        }
      ]
    },
    {
      "type": "ExpansionPanel",
      "caption": "Werkstatt",
      "items": [
        {
          "type": "SelectVariable",
          "name": "WorkshopOut1",
          "caption": "Shelly Ausgang 1: Status"
        },
        {
          "type": "SelectVariable",
          "name": "WorkshopOut2",
          "caption": "Shelly Ausgang 2: Status 1"
        },
        {
          "type": "SelectVariable",
          "name": "WorkshopValve",
          "caption": "Ventil: Position (0–100 %)"
        },
        {
          "type": "SelectVariable",
          "name": "WorkshopTemp",
          "caption": "Ventil: Vorlauftemperatur"
        },
        {
          "type": "NumberSpinner",
          "name": "WorkshopValveDefault",
          "caption": "Anfangswert Ventil-Sollwert bei erster Anlage (%)",
          "minimum": 0,
          "maximum": 100
        },
        {
          "type": "SelectVariable",
          "name": "WorkshopRoomTemp",
          "caption": "Raumtemperatur (optional)"
        }
      ]
    },
    {
      "type": "ExpansionPanel",
      "caption": "Garage",
      "items": [
        {
          "type": "SelectVariable",
          "name": "GarageOut1",
          "caption": "Shelly Ausgang 1: Status"
        },
        {
          "type": "SelectVariable",
          "name": "GarageOut2",
          "caption": "Shelly Ausgang 2: Status 1"
        },
        {
          "type": "SelectVariable",
          "name": "GarageValve",
          "caption": "Ventil: Position (0–100 %)"
        },
        {
          "type": "SelectVariable",
          "name": "GarageTemp",
          "caption": "Ventil: Vorlauftemperatur"
        },
        {
          "type": "NumberSpinner",
          "name": "GarageValveDefault",
          "caption": "Anfangswert Ventil-Sollwert bei erster Anlage (%)",
          "minimum": 0,
          "maximum": 100
        },
        {
          "type": "SelectVariable",
          "name": "GarageRoomTemp",
          "caption": "Raumtemperatur (optional)"
        }
      ]
    },
    {
      "type": "ExpansionPanel",
      "caption": "Betrieb",
      "items": [
        {
          "type": "Label",
          "caption": "Betriebsmodus wird je Heizgebläse über die Instanzvariable im Objektbaum eingestellt. Auto ist vorbereitet, schaltet aber noch nicht ein."
        },
        {
          "type": "NumberSpinner",
          "name": "RefreshSeconds",
          "caption": "Status-/Temperaturabfrage (Sekunden)",
          "minimum": 2,
          "maximum": 3600
        },
        {
          "type": "CheckBox",
          "name": "PumpWatchdog",
          "caption": "Pumpe bei erkanntem laufendem Geblaese automatisch sicherstellen"
        }
      ]
    }
  ],
  "actions": [
    {
      "type": "Label",
      "caption": "AUS: Gebläse und Ventil AUS. Manuell: Stufe 0–3 und gespeicherte Ventilöffnung. Zeitsteuerung: 4 individuelle Zeitfenster je Heizgebläse; außerhalb AUS. Auto: vorbereitet und vorläufig AUS. Pumpe EIN bei mindestens einem laufenden Gebläse."
    }
  ]
}